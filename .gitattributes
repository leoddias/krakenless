# Normalise line endings so a file written by a tool that defaults to CRLF on
# Windows cannot fail `prettier --check` in CI while looking fine locally.
* text=auto eol=lf

# Binary assets are never converted.
*.png binary
*.ico binary
*.icns binary
*.jpg binary
*.woff binary
*.woff2 binary

# Signature fixtures. A byte changed by line-ending conversion is a byte the
# signature no longer covers, so these are never touched — that is the whole
# point of the test that reads them.
src-tauri/tests/fixtures/** binary
