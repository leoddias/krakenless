{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Krakenless",
  "version": "0.1.11",
  "identifier": "dev.krakenless.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Krakenless",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true,
    "resources": ["krakenless-install.marker"]
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://leoddias.github.io/krakenless/updates/{{target}}-{{arch}}.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY4QzkzMjI0MzE2NTAwRjUKUldUMUFHVXhKRExKK0wxRDV4ZXIrenhIRGVQVDE5WlNoL0pFQWVOZFpvRnVtWUE2b0hXVEhleHcK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
